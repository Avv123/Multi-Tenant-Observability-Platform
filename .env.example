# PulseLens environment variables
# Copy this file to .env and customise for your local setup.
# The docker-compose.yml reads these values via ${VAR} substitution.

# Postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pulselens

# ClickHouse
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=changeme
CLICKHOUSE_DB=pulselens

# MinIO object store
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=changeme

# JWT secret used by tenant-service to sign tokens.
JWT_SECRET=your-secure-jwt-secret-here

# Internal service-to-service token.
INTERNAL_TOKEN=your-internal-token-here

# Resource limits.
# Tune these based on your machine capabilities.
POSTGRES_MEM_LIMIT=512m
REDIS_MEM_LIMIT=256m
KAFKA_MEM_LIMIT=1g
CLICKHOUSE_MEM_LIMIT=2g
MINIO_MEM_LIMIT=512m
SERVICE_MEM_LIMIT=256m
UI_MEM_LIMIT=128m
OLLAMA_MEM_LIMIT=4g

# AI Configuration
OLLAMA_MODEL=llama3.2:1b
