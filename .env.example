# PulseLens environment variables
# Copy this file to .env and customise for your local setup.
# The docker-compose.yml reads these values via ${VAR} substitution.
# I4: explicit .env.example so credentials are never hardcoded in docker-compose.

# Postgres
POSTGRES_USER=omniful
POSTGRES_PASSWORD=omniful
POSTGRES_DB=pulselens

# Redis (no auth in local dev)

# ClickHouse
CLICKHOUSE_USER=omniful
CLICKHOUSE_PASSWORD=omniful
CLICKHOUSE_DB=pulselens

# MinIO object store
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# JWT secret used by tenant-service to sign tokens.
# Change this to a long random string before any shared deployment.
JWT_SECRET=pulselens-local-dev-secret-change-me

# Internal service-to-service token (used by ingest → tenant auth).
INTERNAL_TOKEN=pulselens-internal-token

# Resource limits (I1).
# Tune these based on your machine. Values are Docker memory limits.
POSTGRES_MEM_LIMIT=512m
REDIS_MEM_LIMIT=256m
KAFKA_MEM_LIMIT=1g
CLICKHOUSE_MEM_LIMIT=2g
MINIO_MEM_LIMIT=512m
SERVICE_MEM_LIMIT=256m
UI_MEM_LIMIT=128m


